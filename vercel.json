{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "installCommand": "npm install --prefer-offline --no-audit --no-fund",
  "ignoreCommand": "sh scripts/vercel-ignore.sh",
  "crons": [
    {
      "path": "/api/cron/lead-relances",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/partner-growth-engine",
      "schedule": "0 8 * * *"
    }
  ]
}